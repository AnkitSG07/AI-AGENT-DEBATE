# Android machines, build output and private signing material stay outside Git.
android/**/.gradle/
android/**/build/
android/**/local.properties
*.apk
*.jks
*.keystore

# Fresh execution logs are delivered in the verification archive.
verification/r13/*
!verification/r13/release-summary.json
verification/recovery-current/
android/operatorhub/verification/r12/call-320x480-large-font.png
android/operatorhub/verification/r13/

# Final resumed execution evidence is packaged separately.
verification/completion-current/
android/**/build
android/**/build.recovered-source-copy/
