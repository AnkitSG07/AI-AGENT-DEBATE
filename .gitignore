node_modules
.env
.DS_Store

# FedEx locally stored manifests and label PDFs
fedex-data/

# Reproducible local simulator output, never production inputs.
verification/r13/current/
integrations/odoo/tests/r13/workflow-evidence/
integrations/odoo/tests/ui-r12-evidence/
integrations/odoo/tests/*-results.json
tests/simulator-media-r13/evidence/
