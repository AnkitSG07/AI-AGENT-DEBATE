{
  "name": "ai-agent-debate",
  "version": "1.5.0",
  "description": "Multi-AI debate + Odoo-connected PDF shipping labels (with editable label drafts)",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "check:no-duplicate-odoo": "node scripts/check-no-duplicate-odoo.mjs",
    "test:operator-storage": "node scripts/test-operator.mjs",
    "test:operator-r12": "node tests/operator-r12.test.mjs",
    "test:operator-r12:emulator": "node tests/operator-r12-emulator.test.mjs",
    "test:operator-reporting": "node --test reporting/test/operator-reporting.test.mjs reporting/test/terminal-collector-idle.test.mjs",
    "test:operator-call-auth": "node operator-browser-auth.test.mjs",
    "test:operator-r13": "node scripts/verify-r13.mjs",
    "test:operator-r13:media": "node scripts/verify-r13.mjs media",
    "test:operator-cloudflare:emulator": "node scripts/test-storage-migration-emulator.mjs",
    "test:operator-cloudflare": "node --test tests/operator-cloudflare-client.test.mjs tests/operator-cloudflare-runtime.test.mjs tests/operator-storage-journal.test.mjs tests/operator-storage-migration.test.mjs tests/operator-storage-admin.test.mjs tests/operator-storage-admin-routes.test.mjs cloudflare/operator-store/test/store.test.mjs cloudflare/operator-store/test/worker.test.mjs cloudflare/operator-store/test/migration.test.mjs"
  },
  "engines": {
    "node": "24.x"
  },
  "dependencies": {
    "@google-cloud/firestore": "8.7.1",
    "@google/genai": "^0.3.0",
    "@livekit/noise-cancellation-node": "0.3.1",
    "@livekit/rtc-node": "1.2.1",
    "dotenv": "^16.4.5",
    "exceljs": "4.4.0",
    "express": "^4.19.2",
    "jszip": "3.10.1",
    "livekit-server-sdk": "2.18.0",
    "pdfkit": "^0.15.0",
    "web-push": "^3.6.7"
  }
}
