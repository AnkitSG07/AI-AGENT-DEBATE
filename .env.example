# ======================
# App
# ======================
APP_URL=https://your-render-app.onrender.com
PORT=3000

# ======================
# AI Providers
# ======================
GEMINI_API_KEY=YOUR_GEMINI_KEY
OPENROUTER_API_KEY=YOUR_OPENROUTER_KEY

OR_MODEL_LLAMA=meta-llama/llama-3.1-8b-instruct
OR_MODEL_MISTRAL=google/gemma-2-9b-it

# ======================
# Odoo Online (JSON-RPC)
# ======================
ODOO_URL=https://vaidahi-kala-pvt-ltd.odoo.com
ODOO_DB=vaidahi-kala-pvt-ltd
ODOO_USERNAME=your_odoo_login_email
ODOO_API_KEY_OR_PASSWORD=your_odoo_api_key

# Required for the Odoo sale-confirmed webhook; missing configuration fails closed.
ODOO_WEBHOOK_SECRET=some_long_random_secret

# ======================
# PDF Label: Default "From" Address
# ======================
SHIP_FROM_NAME=Smart Handicrafts
SHIP_FROM_COMPANY=VAIDAHI KALA Pvt. Ltd.
SHIP_FROM_PHONE=+91-9315155031
SHIP_FROM_EMAIL=care@smarthandicrafts.in
SHIP_FROM_LINE1=First Floor, A 23, Okhla Phase I
SHIP_FROM_LINE2=Mayapuri, New Delhi, Delhi, 110020
SHIP_FROM_CITY=New Delhi
SHIP_FROM_STATE=Delhi
SHIP_FROM_PIN=110020
SHIP_FROM_COUNTRY=India

# FedEx sandbox keys: configure these in Render > Environment, NOT in source control
FEDEX_MODE=sandbox
FEDEX_SHIPPING_CLIENT_ID=
FEDEX_SHIPPING_CLIENT_SECRET=
FEDEX_TRACKING_CLIENT_ID=
FEDEX_TRACKING_CLIENT_SECRET=
FEDEX_SANDBOX_ACCOUNT=
# Optional sender / warehouse contact (should match actual pickup location):
FEDEX_ORIGIN_CONTACT=
FEDEX_ORIGIN_COMPANY=
FEDEX_ORIGIN_PHONE=
FEDEX_ORIGIN_EMAIL=
FEDEX_ORIGIN_LINE1=
FEDEX_ORIGIN_LINE2=
FEDEX_ORIGIN_CITY=
FEDEX_ORIGIN_STATE_CODE=DL
FEDEX_ORIGIN_POSTAL=
FEDEX_ORIGIN_COUNTRY=IN
# Use a Render persistent disk path for durable shipment/label history (optional)
FEDEX_DATA_DIR=./fedex-data
# Required for private Operator Hub services. At least 32 non-whitespace random
# characters; generate a secret outside source control. Rotation also invalidates
# browser capabilities, signed document links and pending AI reply grants.
PROFILE_SESSION_SECRET=
# Production only after validation: use separate production keys, never overwrite test keys
# FEDEX_ACCOUNT_NUMBER=
# FEDEX_SHIPPING_PROD_CLIENT_ID=
# FEDEX_SHIPPING_PROD_CLIENT_SECRET=
# FEDEX_TRACKING_PROD_CLIENT_ID=
# FEDEX_TRACKING_PROD_CLIENT_SECRET=
# FEDEX_ENABLE_LIVE_ACTIONS=false

# ======================
# Operator Hub R13 private services
# See docs/r13/backend-private-integrations.md before rollout. Empty values below
# are placeholders; do not replace working Render credentials with these blanks.
# ======================
PROFILE_PASS_SMART_HANDICRAFTS=
PROFILE_PASS_SUDO=
PROFILE_PASS_ACCOUNTS=

# Reuse the existing server-only Firebase configuration for durable devices and
# AI reply/handover receipts. Never put the service account in the APK or embed.
SH_ANDROID_REGISTRY_BACKEND=firestore
SH_ANDROID_FIREBASE_PROJECT_ID=
SH_ANDROID_FIREBASE_SERVICE_ACCOUNT_JSON=
SH_OPERATOR_FIRESTORE_DATABASE=(default)
SH_OPERATOR_FIRESTORE_PREFIX=sh_operator

# Map only verified active INTERNAL res.users IDs from the current Odoo database.
# Allowed keys: test, ankit, kushagra, vibhu (khushagra is accepted as an alias).
# {} deliberately means no delivery mapping; a saved handover is not a sent alert.
SH_AI_HANDOVER_USER_IDS_JSON={}

# Existing callback authority, now mandatory. Preserve any working values.
# Zapier must ALSO echo the incoming ai_reply_grant field in its reply JSON.
ZAPIER_REPLY_SECRET=
# Set the existing valid catch URL in the environment; never hardcode it in source.
ZAPIER_INCOMING_WHATSAPP_WEBHOOK_URL=
# Legacy alias ZAPIER_WEBHOOK_URL remains supported if the primary URL is empty.
ZAPIER_INCOMING_WHATSAPP_ENABLED=true
META_WHATSAPP_APP_SECRET=

# Optional separate server-to-server key for approved Kit AI training. Without
# this key, only a signed same-origin SUDO profile can approve a training rule.
TRAINING_ADMIN_KEY=
